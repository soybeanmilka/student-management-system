# ============================================================
# 工程代码 —— C++【排版】风格
#
# 基线：Google C++ Style Guide，由 clang-format 执行。
# 谁读它：clangd 内置的 clang-format（你在 VS Code 里保存时的格式化）。
#
# 作用范围：本目录及所有子目录。
#   clang-format 和 clangd 都遵循"离文件最近的配置优先"，
#   所以子目录里放一份自己的 .clang-format 就能局部覆盖。
#   竞赛刷题代码在 ../ACM/，那里有自己的配置。
#
# 重要：本文件只管"排版"——缩进、换行、对齐、括号位置。
#       它一个字都不会改你的标识符名字。
#       命名规则在同目录的 .clang-tidy 里。
#
# 完整说明与验证方法见 ../README.md
# ============================================================

BasedOnStyle: Google

# 唯一的非风格项：与 g++ 16.2.0 的默认标准对齐，
# 避免编辑器解析和本地编译对语言特性的判断不一致。
Standard: c++20

# ------------------------------------------------------------
# 缩进：4 格空格，禁用 Tab
#
# 【为什么不再沿用 Google 原版的 2 格】
# 因为手写习惯就是 4 格。以前这里是纯 Google（2 格），实测会出两种现象：
#   1) 整篇格式化（Ctrl+Shift+I）：手里写的 4 格被整体压成 2 格；
#   2) 格式化选定内容（Ctrl+K Ctrl+F）：它只重排【选中的行】，选区外
#      一个字都不动。于是选区外保持 4 格，选区内按配置的 2 格基准重算，
#      结果外层 4、内层 6 —— 父子只差 2 格，看起来"缩进歪了"。
#      而且每次选的范围不同，混出来的样子就不同。
#
# 关键模型：格式化器的缩进来自【配置文件】，不来自你已有的代码。
# 只要配置和手写习惯不一致，任何"局部格式化"都会产生新旧混合。
# 让两者一致，整篇和选区两条路径才会给出同一个结果。
# ------------------------------------------------------------
IndentWidth: 4
TabWidth: 4
UseTab: Never

# 类里的 public: / private: 往左顶 4 格，和 class 关键字对齐。
# Google 预置是 -1（配 2 格缩进），缩进改成 4 之后必须一起改，
# 否则 public: 会卡在奇怪的位置上。
AccessModifierOffset: -4

# 续行缩进 4 格（Google 默认也是 4，这里写出来是为了显式）
ContinuationIndentWidth: 4

# ------------------------------------------------------------
# 指针 / 引用的星号贴着类型写
#   int* p;      int& r;      (int*)malloc
#
# PointerAlignment: Left 表示星号归类型，变量名前留一个空格。
# 另外两种是 Right（int *p，Google 默认）和 Middle（int * p）。
#
# DerivePointerAlignment: false 必须显式关掉：
#   Google 预置里它是 true，意思是"clang-format 先统计本文件里已有的
#   写法，多数派说了算"，PointerAlignment 只当兜底。不关掉的话，
#   同一份配置在不同文件上可能给出不同结果（取决于你当初怎么写），
#   这和上面 IndentWidth 那节是同一个道理：格式化结果只应由配置决定。
# ------------------------------------------------------------
PointerAlignment: Left
DerivePointerAlignment: false

# ------------------------------------------------------------
# 控制语句 / 函数头"后面"的空格
#
# SpaceBeforeParens: ControlStatements
#   只有控制语句的圆括号前留一个空格：
#     if (x)      for (int i = 0; i < 5; i++)      while (x)      switch (x)
#   函数名后面不留空格：
#     int main()      ReturnIntValue(a)      sizeof(p)
#   想让函数也留空格（int main ()），改成 Always；
#   想全部去掉（for(...)），改成 Never。
#
# BreakBeforeBraces: Attach
#   花括号跟在同一行，且它前面留一个空格：
#     int main() {        for (...) {        if (...) {
#   这就是 K&R 风格。改成 Allman 会让 { 单独占一行。
# ------------------------------------------------------------
SpaceBeforeParens: ControlStatements
BreakBeforeBraces: Attach

# ------------------------------------------------------------
# 二元运算符前后的空格：a + b、i < 5、i = 0
#
# 【踩过的坑】clang-format 23 里没有 SpaceBeforeBinaryOperators /
# SpaceAfterBinaryOperators 这两个键了。老博客里还有它们，但写进本文件会
# 直接报 "unknown key" 并让【整份配置失效】——格式化会退回默认风格，
# 而不是只忽略这一行。所以键名要以本机版本为准：
#   clang-format -style=Google -dump-config
# 现在运算符两侧的空格是固定行为，不用配也配不了；
# sizeof(p)*5 照样会被补成 sizeof(p) * 5。
#
# 赋值号是少数还能单独调的：SpaceBeforeAssignmentOperators
# （默认 true，即 a = b，而不是 a= b）。
# ------------------------------------------------------------
SpaceBeforeAssignmentOperators: true

# ------------------------------------------------------------
# 关掉自动换行
#
# 原来用 Google 的 80 列。缩进从 2 格改成 4 格之后，同一行代码会
# 多占 2 列，更容易顶破 80 列的边界，把长表达式切得更碎。
# 与其反复调列宽数值，不如把换行权交回自己手里：
# 一行太长通常是因为表达式本身太复杂，那更该做的是拆成两步，
# 而不是让格式化器替你决定断在哪里。
#
# 这一项与 ../ACM/.clang-format 保持一致。
# ------------------------------------------------------------
ColumnLimit: 0

# ------------------------------------------------------------
# #include 排序：沿用 Google 预置（自动按字母序排）
#
# 注意它和 ColumnLimit 无关，即使不自动换行，include 依然会被整理。
# 想完全手工控制顺序，就取消下面这行的注释。
# ------------------------------------------------------------
# SortIncludes: Never
